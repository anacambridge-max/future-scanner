# Server-only broker credentials
UPSTOX_ACCESS_TOKEN=

# PostgreSQL
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_NAME=FUTURE SCANNER
SCANNER_MODE=paper
MARKET_DATA_PROVIDER=upstox

# Optional scanner defaults — exact source thresholds should be configured after implementation
EMA_FAST=10
EMA_SLOW=20
ATR_LENGTH=14
VOLUME_THRESHOLD=
GAP_THRESHOLD=
EARLY_SESSION_ENABLED=true
EARLY_SESSION_START=09:15
EARLY_SESSION_END=10:00
MARKET_FILTER_ENABLED=true
EVENT_FILTER_ENABLED=true
RISK_PER_TRADE=
MAX_DAILY_LOSS=
TARGET_RR=
SLIPPAGE=
BROKERAGE=
